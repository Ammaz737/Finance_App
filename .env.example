NODE_ENV=development

# Matches docker compose postgres service (see docker-compose.yml)
DATABASE_URL=postgresql://finance:finance@localhost:5432/finance
REDIS_URL=redis://localhost:6379

STORAGE_DRIVER=local
STORAGE_PATH=./data/uploads

OPENAI_API_KEY=

JWT_SECRET=dev-jwt-secret-change-me
ENCRYPTION_KEY=dev-encryption-key-32chars!!
# Comma-separated trusted browser origins. Required when NODE_ENV=production.
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

APP_URL=http://localhost:3000
API_URL=http://localhost:3001
MOBILE_DEEP_LINK_SCHEME=financeapp

# Card issuer: mock (local sandbox) | stripe (Stripe Issuing). Never expose secret keys to the client.
CARD_ISSUER_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ISSUING_CURRENCY=usd
# Required on Stripe accounts that use money-management / v2 financial accounts (Dashboard → Financial accounts).
STRIPE_FINANCIAL_ACCOUNT_ID=

FEATURE_TRAVEL_EMPLOYEE_REWARDS=false
FEATURE_SHEETS_REALTIME_COLLAB=false
NEXT_PUBLIC_ENABLE_P1_ROUTES=false
NEXT_PUBLIC_ENABLE_P2_ROUTES=false
SEED_PASSWORD=password123
