NODE_ENV=development

# Matches docker compose postgres service (see docker-compose.yml)
DATABASE_URL=postgresql://finance:finance@localhost:5432/finance
REDIS_URL=redis://localhost:6379

STORAGE_DRIVER=local
STORAGE_PATH=./data/uploads

OPENAI_API_KEY=

JWT_SECRET=dev-jwt-secret-change-me
ENCRYPTION_KEY=dev-encryption-key-32chars!!
# Comma-separated trusted browser origins. Required when NODE_ENV=production.
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

APP_URL=http://localhost:3000
API_URL=http://localhost:3001
MOBILE_DEEP_LINK_SCHEME=financeapp

# Card issuer: mock (local sandbox) | stripe (Stripe Issuing). Never expose secret keys to the client.
CARD_ISSUER_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ISSUING_CURRENCY=usd
# Required on Stripe accounts that use money-management / v2 financial accounts (Dashboard → Financial accounts).
STRIPE_FINANCIAL_ACCOUNT_ID=

# Bill-pay rail: mock | stripe (defaults to CARD_ISSUER_PROVIDER). Stripe mode debits FA on Release.
PAYMENT_RAIL_PROVIDER=
# Optional dedicated Issuing card (ic_…) for bill-pay FA debits. Auto-created if empty.
STRIPE_BILL_PAY_CARD_ID=

FEATURE_TRAVEL_EMPLOYEE_REWARDS=false
FEATURE_SHEETS_REALTIME_COLLAB=false
NEXT_PUBLIC_ENABLE_P1_ROUTES=false
NEXT_PUBLIC_ENABLE_P2_ROUTES=false
SEED_PASSWORD=password123

# Travel: mock | duffel
TRAVEL_PROVIDER=mock
# Enable only after these features are active on your Duffel account.
DUFFEL_ENABLE_STAYS=false
DUFFEL_ENABLE_CARS=false
DUFFEL_ACCESS_TOKEN=
DUFFEL_API_VERSION=v2
# Returned once when creating the webhook endpoint in Duffel Dashboard / API
DUFFEL_WEBHOOK_SECRET=

# QuickBooks Online: create an Accounting app at developer.intuit.com.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox
# Must exactly match the redirect URI configured in the Intuit app.
QUICKBOOKS_REDIRECT_URI=http://localhost:3001/api/v1/integrations/quickbooks/callback
# Intuit app webhook verifier token (Development or Production as appropriate).
QUICKBOOKS_WEBHOOK_VERIFIER_TOKEN=
