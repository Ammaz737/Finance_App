# Normalize line endings for all text files to LF in the repo,
# but let Git handle checkout according to OS defaults.
* text=auto eol=lf

# Explicitly keep these as LF everywhere (scripts, configs, source)
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.env   text eol=lf
*.sql   text eol=lf
*.prisma text eol=lf
*.gitkeep text eol=lf

# Windows-specific scripts can stay CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary files — no line-ending conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.otf   binary
*.zip   binary
*.gz    binary
