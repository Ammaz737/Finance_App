generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("organizations")
}

model LegalEntity {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  country        String
  currency       String   @default("USD")
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("legal_entities")
}

model CountryCapability {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  country        String
  cardsSupported Boolean  @default(true) @map("cards_supported")
  billPaySupported Boolean @default(true) @map("bill_pay_supported")
  reimbursementSupported Boolean @default(true) @map("reimbursement_supported")
  travelSupported Boolean @default(true) @map("travel_supported")
  taxCaptureSupported Boolean @default(false) @map("tax_capture_supported")
  rails          Json     @default("[]")
  effectiveFrom  DateTime @default(now()) @map("effective_from")
  effectiveTo    DateTime? @map("effective_to")

  @@unique([organizationId, country])
  @@map("country_capabilities")
}

model User {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  email          String
  passwordHash   String   @map("password_hash")
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  status         String   @default("DRAFT")
  managerId      String?  @map("manager_id")
  departmentId   String?  @map("department_id")
  locationId     String?  @map("location_id")
  mfaEnabled     Boolean  @default(false) @map("mfa_enabled")
  passwordMustChange Boolean @default(false) @map("password_must_change")
  activationTokenHash String? @map("activation_token_hash")
  activationExpiresAt DateTime? @map("activation_expires_at")
  passwordResetTokenHash String? @map("password_reset_token_hash")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")
  legalEntityId String? @map("legal_entity_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@index([organizationId, passwordResetTokenHash])
  @@map("users")
}

model Session {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  tokenHash      String   @unique @map("token_hash")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model Department {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  name           String
  status         String @default("ACTIVE")

  @@unique([organizationId, name])
  @@map("departments")
}

model Location {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  name           String
  status         String @default("ACTIVE")

  @@unique([organizationId, name])
  @@map("locations")
}

model Role {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  name           String
  description    String @default("")

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  id    String @id @default(uuid())
  key   String @unique
  label String

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")
  scope        String @default("ORGANIZATION")

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  userId         String  @map("user_id")
  roleId         String  @map("role_id")
  entityId       String? @map("entity_id")

  @@unique([userId, roleId, entityId])
  @@map("user_roles")
}

model Entitlement {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  featureKey     String  @map("feature_key")
  enabled        Boolean @default(true)

  @@unique([organizationId, featureKey])
  @@map("entitlements")
}

model Policy {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  name           String
  objectType     String @map("object_type")
  enabled        Boolean @default(true)
  version        Int     @default(1)
  priority       Int     @default(100)
  rules          Json   @default("[]")
  effectiveFrom  DateTime @default(now()) @map("effective_from")
  effectiveTo    DateTime? @map("effective_to")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, objectType, enabled])
  @@map("policies")
}

model ApprovalWorkflow {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  name           String
  objectType     String @map("object_type")
  version        Int    @default(1)
  steps          Json
  enabled        Boolean @default(false)
  effectiveFrom  DateTime @default(now()) @map("effective_from")
  effectiveTo    DateTime? @map("effective_to")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, objectType])
  @@map("approval_workflows")
}

model ApprovalInstance {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  workflowId     String   @map("workflow_id")
  workflowVersion Int     @default(1) @map("workflow_version")
  objectType     String   @map("object_type")
  objectId       String   @map("object_id")
  requesterId    String   @map("requester_id")
  status         String   @default("IN_REVIEW")
  currentStep    Int      @default(0) @map("current_step")
  priority       String   @default("NORMAL")
  dueAt          DateTime? @map("due_at")
  infoRequestedAt DateTime? @map("info_requested_at")
  infoRequestComment String @default("") @map("info_request_comment")
  assigneeUserId String?  @map("assignee_user_id")
  escalatedAt    DateTime? @map("escalated_at")
  parallelApprovals Json  @default("[]") @map("parallel_approvals")
  resolvedSteps  Json     @default("[]") @map("resolved_steps")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organizationId, objectType, objectId])
  @@index([organizationId, status])
  @@map("approval_instances")
}

model ApprovalAction {
  id             String   @id @default(uuid())
  instanceId     String   @map("instance_id")
  actorId        String   @map("actor_id")
  action         String
  comment        String   @default("")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("approval_actions")
}

model InboxItem {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  type           String
  objectType     String   @map("object_type")
  objectId       String   @map("object_id")
  approvalInstanceId String? @map("approval_instance_id")
  assigneeId     String?  @map("assignee_id")
  requestedById  String?  @map("requested_by_id")
  legalEntityId  String?  @map("legal_entity_id")
  title          String
  amount         Decimal? @db.Decimal(18, 2)
  currency       String   @default("USD")
  priority       String   @default("NORMAL")
  status         String   @default("OPEN")
  policySummary  String   @default("") @map("policy_summary")
  currentStep    Int      @default(0) @map("current_step")
  totalSteps     Int      @default(1) @map("total_steps")
  dueAt          DateTime? @map("due_at")
  availableActions Json   @default("[]") @map("available_actions")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organizationId, status, type])
  @@index([organizationId, objectType, objectId])
  @@map("inbox_items")
}

model AuditEvent {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  actorId        String?  @map("actor_id")
  actorType      String   @default("INTERNAL_USER") @map("actor_type")
  agentId        String?  @map("agent_id")
  action         String
  objectType     String   @map("object_type")
  objectId       String   @map("object_id")
  oldValue       Json?    @map("old_value")
  newValue       Json?    @map("new_value")
  source         String   @default("web")
  correlationId  String?  @map("correlation_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("audit_events")
}

model OutboxEvent {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  type           String
  payload        Json
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  availableAt    DateTime  @default(now()) @map("available_at")
  claimedAt      DateTime? @map("claimed_at")
  publishedAt    DateTime? @map("published_at")
  deadLetterAt   DateTime? @map("dead_letter_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([publishedAt, availableAt, deadLetterAt])
  @@map("outbox_events")
}

model IdempotencyKey {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  key            String
  requestHash    String   @map("request_hash")
  response       Json
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([organizationId, key])
  @@map("idempotency_keys")
}

model Attachment {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  legalEntityId  String?  @map("legal_entity_id")
  originalName   String   @map("original_name")
  storedName     String   @map("stored_name")
  mimeType       String   @map("mime_type")
  size           Int
  checksum       String
  storagePath    String   @map("storage_path")
  classification String   @default("attachment")
  malwareStatus  String   @default("QUARANTINED") @map("malware_status")
  ocrStatus      String?  @map("ocr_status")
  ocrPayload     Json?    @map("ocr_payload")
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("attachments")
}

model Notification {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  type           String
  title          String
  body           String
  href           String   @default("")
  objectType     String?  @map("object_type")
  objectId       String?  @map("object_id")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@index([organizationId, userId, createdAt])
  @@map("notifications")
}

model IntegrationConnection {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  family         String
  provider       String
  status         String    @default("CONNECTED")
  health         String    @default("UNKNOWN")
  cursor         String?
  lastSyncAt     DateTime? @map("last_sync_at")
  lastError      String    @default("") @map("last_error")
  config         Json      @default("{}")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([organizationId, family])
  @@map("integration_connections")
}

model BusinessLimit {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  legalEntityId  String  @map("legal_entity_id")
  amount         Decimal @db.Decimal(18, 2)
  currency       String
  @@map("business_limits")
}

model Budget {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  legalEntityId  String  @map("legal_entity_id")
  name           String
  ownerId        String? @map("owner_id")
  amount         Decimal @db.Decimal(18, 2)
  actualAmount   Decimal @default(0) @map("actual_amount") @db.Decimal(18, 2)
  committedAmount Decimal @default(0) @map("committed_amount") @db.Decimal(18, 2)
  currency       String
  period         String  @default("ANNUAL")
  freshness      DateTime @default(now())
  updatedAt      DateTime @updatedAt @map("updated_at")
  @@index([organizationId, legalEntityId])
  @@map("budgets")
}

model SavedView {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  resource       String
  name           String
  filters        Json     @default("{}")
  columns        Json     @default("[]")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organizationId, userId, resource])
  @@map("saved_views")
}

model SpendProgram {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  legalEntityId  String  @map("legal_entity_id")
  name           String
  description    String  @default("")
  workflowId     String? @map("workflow_id")
  budgetId       String? @map("budget_id")
  maxAmount      Decimal @map("max_amount") @db.Decimal(18, 2)
  currency       String
  status         String  @default("ACTIVE")
  frequency      String  @default("ONE_TIME")
  resetRule      String  @default("NONE") @map("reset_rule")
  startDate      DateTime? @map("start_date")
  endDate        DateTime? @map("end_date")
  eligibleDepartmentIds Json @default("[]") @map("eligible_department_ids")
  eligibleLocationIds   Json @default("[]") @map("eligible_location_ids")
  eligibleRoleNames     Json @default("[]") @map("eligible_role_names")
  eligibleUserIds       Json @default("[]") @map("eligible_user_ids")
  defaultFulfillmentType String @default("VIRTUAL_CARD") @map("default_fulfillment_type")
  merchantLockDefault String? @map("merchant_lock_default")
  defaultValidDays Int?  @map("default_valid_days")
  allowedMccsDefault String? @map("allowed_mccs_default")
  perTransactionLimitDefault Decimal? @map("per_transaction_limit_default") @db.Decimal(18, 2)
  velocityMaxAmountDefault Decimal? @map("velocity_max_amount_default") @db.Decimal(18, 2)
  velocityMaxCountDefault Int? @map("velocity_max_count_default")
  @@map("spend_programs")
}

model SpendRequest {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  legalEntityId  String  @map("legal_entity_id")
  programId      String  @map("program_id")
  requesterId    String  @map("requester_id")
  name           String
  purpose        String  @default("")
  category       String  @default("")
  vendorId       String? @map("vendor_id")
  amount         Decimal @db.Decimal(18, 2)
  currency       String
  status         String  @default("DRAFT")
  fulfillmentType String @default("VIRTUAL_CARD") @map("fulfillment_type")
  recurrence     String  @default("NONE")
  expiresAt      DateTime? @map("expires_at")
  attachmentId   String? @map("attachment_id")
  comments       String  @default("")
  policyResult   String  @default("") @map("policy_result")
  policyReason   String  @default("") @map("policy_reason")
  policyMatchedRules Json @default("[]") @map("policy_matched_rules")
  policyRequiredActions Json @default("[]") @map("policy_required_actions")
  policyVersion  Int     @default(0) @map("policy_version")
  policyEvaluatedAt DateTime? @map("policy_evaluated_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  @@map("spend_requests")
}

model Fund {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  legalEntityId  String  @map("legal_entity_id")
  name           String
  ownerId        String  @map("owner_id")
  spendRequestId String? @map("spend_request_id")
  availableAmount Decimal @map("available_amount") @db.Decimal(18, 2)
  limitAmount    Decimal @map("limit_amount") @db.Decimal(18, 2)
  currency       String
  status         String  @default("ACTIVE")
  validFrom      DateTime @default(now()) @map("valid_from")
  validTo        DateTime? @map("valid_to")

  @@unique([organizationId, spendRequestId])
  @@map("funds")
}

model Card {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  legalEntityId  String  @map("legal_entity_id")
  fundId         String  @map("fund_id")
  holderId       String  @map("holder_id")
  type           String
  last4          String
  token          String
  providerRef    String? @map("provider_ref")
  network        String  @default("MOCK")
  status         String  @default("ACTIVE")
  merchantLock   String? @map("merchant_lock")
  allowedMccs    String? @map("allowed_mccs")
  perTransactionLimit Decimal? @map("per_transaction_limit") @db.Decimal(18, 2)
  velocityMaxAmount Decimal? @map("velocity_max_amount") @db.Decimal(18, 2)
  velocityMaxCount Int?  @map("velocity_max_count")
  velocityWindowHours Int @default(24) @map("velocity_window_hours")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([organizationId, fundId])
  @@map("cards")
}

model CardAuthorization {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  cardId         String  @map("card_id")
  fundId         String  @map("fund_id")
  amount         Decimal @db.Decimal(18, 2)
  currency       String
  merchant       String
  merchantCategory String @map("merchant_category")
  decision       String
  reason         String  @default("")
  providerEventId String? @map("provider_event_id")
  idempotencyKey String  @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([organizationId, idempotencyKey])
  @@map("card_authorizations")
}

model LedgerTransaction {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  memo           String
  createdAt      DateTime @default(now()) @map("created_at")
  @@map("ledger_transactions")
}

model LedgerEntry {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  ledgerTxId     String  @map("ledger_tx_id")
  account        String
  direction      String
  amount         Decimal @db.Decimal(18, 2)
  currency       String
  @@map("ledger_entries")
}

model Txn {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  legalEntityId  String  @map("legal_entity_id")
  cardId         String? @map("card_id")
  fundId         String? @map("fund_id")
  authorizationId String? @map("authorization_id")
  vendorId       String? @map("vendor_id")
  amount         Decimal @db.Decimal(18, 2)
  currency       String
  merchant       String
  status         String  @default("PENDING")
  memo           String  @default("")
  authorizedAt   DateTime @default(now()) @map("authorized_at")
  clearedAt      DateTime? @map("cleared_at")
  capturedAmount Decimal? @map("captured_amount") @db.Decimal(18, 2)
  voidedAt       DateTime? @map("voided_at")
  reversedAt     DateTime? @map("reversed_at")
  providerClearEventId String? @map("provider_clear_event_id")
  @@index([organizationId, status])
  @@index([organizationId, cardId, authorizedAt])
  @@map("transactions")
}

model Receipt {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  attachmentId   String  @map("attachment_id")
  transactionId  String? @map("transaction_id")
  expenseId      String? @map("expense_id")
  reimbursementId String? @map("reimbursement_id")
  merchantGuess  String? @map("merchant_guess")
  amountGuess    Decimal? @map("amount_guess") @db.Decimal(18, 2)
  matchStatus    String  @default("UNMATCHED") @map("match_status")
  ocrStatus      String  @default("PENDING") @map("ocr_status")
  ocrPayload     Json?   @map("ocr_payload")
  createdAt      DateTime @default(now()) @map("created_at")
  @@unique([organizationId, attachmentId])
  @@index([organizationId, expenseId])
  @@index([organizationId, transactionId])
  @@index([organizationId, reimbursementId])
  @@map("receipts")
}

model Expense {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  legalEntityId  String  @map("legal_entity_id")
  userId         String  @map("user_id")
  transactionId  String? @map("transaction_id")
  receiptId      String? @map("receipt_id")
  amount         Decimal @db.Decimal(18, 2)
  currency       String
  merchant       String
  memo           String  @default("")
  status         String  @default("INCOMPLETE")
  policyResult   String  @default("PASS") @map("policy_result")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  @@unique([organizationId, transactionId])
  @@index([organizationId, status])
  @@map("expenses")
}

model ExpenseSplit {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  expenseId      String  @map("expense_id")
  amount         Decimal @db.Decimal(18, 2)
  category       String
  department     String  @default("")
  @@index([organizationId, expenseId])
  @@map("expense_splits")
}

model Reimbursement {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  legalEntityId  String  @map("legal_entity_id")
  userId         String  @map("user_id")
  type           String  @default("STANDARD")
  amount         Decimal @db.Decimal(18, 2)
  currency       String
  status         String  @default("DRAFT")
  memo           String  @default("")
  merchant       String  @default("")
  category       String  @default("")
  expenseDate    DateTime? @map("expense_date")
  destination    String  @default("")
  startDate      DateTime? @map("start_date")
  endDate        DateTime? @map("end_date")
  eligibleDays   Int?    @map("eligible_days")
  department     String  @default("")
  project        String  @default("")
  paymentDestination String @default("") @map("payment_destination")
  receiptId      String? @map("receipt_id")
  receiptFingerprint String @default("") @map("receipt_fingerprint")
  distanceMiles  Decimal? @map("distance_miles") @db.Decimal(18, 2)
  mileageRate    Decimal? @map("mileage_rate") @db.Decimal(18, 4)
  perDiemNights  Int?    @map("per_diem_nights")
  perDiemRate    Decimal? @map("per_diem_rate") @db.Decimal(18, 2)
  rateSource     String  @default("") @map("rate_source")
  rateVersion    String  @default("") @map("rate_version")
  calcBreakdown  Json?   @map("calc_breakdown")
  policyResult   String  @default("PASS") @map("policy_result")
  policyReason   String? @map("policy_reason")
  policyMatchedRules Json @default("[]") @map("policy_matched_rules")
  policyRequiredActions Json @default("[]") @map("policy_required_actions")
  policyVersion  Int?    @map("policy_version")
  policyEvaluatedAt DateTime? @map("policy_evaluated_at")
  duplicateStatus String @default("CLEAR") @map("duplicate_status")
  duplicateOfId  String? @map("duplicate_of_id")
  approvalProgress String @default("") @map("approval_progress")
  payoutRail     String? @map("payout_rail")
  payoutStatus   String  @default("") @map("payout_status")
  providerRef    String? @map("provider_ref")
  settlementRef  String? @map("settlement_ref")
  releasedBy     String? @map("released_by")
  failureReason  String  @default("") @map("failure_reason")
  scheduledAt    DateTime? @map("scheduled_at")
  paidAt         DateTime? @map("paid_at")
  returnedAt     DateTime? @map("returned_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  @@index([organizationId, status])
  @@index([organizationId, userId, status])
  @@map("reimbursements")
}

model AccountingDimension {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  key            String
  label          String
  values         Json   @default("[]")
  providerSynced Boolean @default(false) @map("provider_synced")
  source         String @default("LOCAL")
  updatedAt      DateTime @updatedAt @map("updated_at")
  @@unique([organizationId, key])
  @@map("accounting_dimensions")
}

model AccountingEntry {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  legalEntityId  String  @map("legal_entity_id")
  sourceType     String  @map("source_type")
  sourceId       String  @map("source_id")
  status         String  @default("NEEDS_REVIEW")
